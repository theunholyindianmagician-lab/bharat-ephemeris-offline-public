 "files": {
  "etext:jm/abh2.md": {
   "sha256": "a4c6954a16311b7eea1c0d4b2748be94beb3e1cae1482c116b8a328f1a8da31d",
   "copy": "whole lines up to 300 characters",
   "lines": {
    "166": {
     "text": " यच्छेषतयात्र लौकिकगणितन्यायमशेषं गणितपादेन प्रत्य[^1]पीपदत्, तमेव कालं ज्योतिर्गतिविशेषैरनुमापयितुं कालक्रियापद आरभ्यते। तत्र मन्त्रार्थवादेतिहासपुराणेषु लोके च प्रसिद्धः कालविभाग एव क्षेत्रविभागेऽपि मूलं निरूप्यमाणे, इति प्रसिद्धस्तद्विभाग एव क्षेत्रेऽतिदिश्यते वर्षमित्यादिनार्याद्वितयेन-",
     "sha256": "ed1086707cdba4504e3a243cf12c680288e8653f045931725620003edfd68f94"
    },
    "170": {
     "text": "**वर्षं द्वादश मासास्त्रिंशद्दिवसो भवेत् स मासस्तु ।**",
     "sha256": "ce4b273594ecefceee90f52bc31d69b6959231251b0cda96b028049cbaf42956"
    },
    "172": {
     "text": "**षष्टिर्नाड्यो दिवसः षष्टिश्च[^2] विनाडिका नाडी ॥ १ ॥**",
     "sha256": "31088ea53f8087334d100a76c523b884b44b753ac5ea220c4f2f5d4ede3cb875"
    },
    "176": {
     "text": "**गुर्वक्षराणि षष्टिर्विनाडिकार्क्षी षडेव वा प्राणाः ।**",
     "sha256": "c6723fa939b8f002b312e2fca661439851f61f30b27fb8c8fd168827fb777568"
    },
    "178": {
     "text": "**एवं कालविभागः क्षेत्रविभागस्तथा भगणात् ॥ २ ॥ **",
     "sha256": "5cc914901882ed031f5bd1b4701b2e8ae4554b40d2eeae058cc88364a27a2af2"
    },
    "181": {
     "excerpts": [
      "आर्क्ष्या विनाड्याः षष्ट्यंश एव मध्यमवृत्त्या गुर्वक्षरोच्चारणकालः।",
      "स्वस्थस्य जन्तोर्निःश्वासश्च तस्या एव षडंशः।"
     ],
     "length": 576,
     "sha256": "8bfa59b600fde16270300b77f55fc5a412bb4982caac3fe140570dc3cc7de9f7"
    },
    "252": {
     "text": "**रविभगणा रव्यव्दा रविशशियोगा भवन्ति शशिमासाः। **",
     "sha256": "252cbd8e38a7151ac617b8322b0f7e017d6933d3206692c4dfc7c5c7a6e941cb"
    },
    "254": {
     "text": "**रविभूयोगा दिवसा भावर्ताश्चापि नाक्षत्राः ॥ ५ ॥ **",
     "sha256": "cbb841413b77ff8cdf323f4c40827a19d7861d8821091ee66182d2e95f9b6837"
    },
    "308": {
     "text": "**रविवर्षं मानुष्यं तदपि त्रिंशद्गुणं भवति पित्र्यम्।**",
     "sha256": "252e1248b8161b23663636b3af310eb2b92e04a97b1a2f53d1f69bd744b8f751"
    },
    "310": {
     "text": "**पित्र्यं द्वादशगुणितं दिव्यं वर्षं समुद्दिष्टम् ॥ ७ ॥**",
     "sha256": "4efe5b0b1815d4bc714dbb9fedda49886732a8135576ee565ae3efd31bc89ce1"
    },
    "312": {
     "text": "**दिव्यं वर्षसहस्रं ग्रहसामान्यं युगं द्विषट्कगुणम् ।**",
     "sha256": "b14e3427e61bacbbdba58f431881740ff8c5ad617a6a673af7a8ea467156b708"
    },
    "314": {
     "text": "**अष्टोत्तरं सहस्रं ब्राह्मो दिवसो ग्रहयुगानाम् ॥ ८ ॥ **",
     "sha256": "108d3b21344a2e47cf55580d557424f21f21eac965d7aac6c9c083aeb864f938"
    },
    "446": {
     "text": "**षष्ट्यब्दानां षष्टिर्यदा व्यतीतास्त्रयश्च युगपादाः।**",
     "sha256": "faa4218eb695a07b40a24dedd3a9978a515fde6ad6e53f458925207d6ffd75ff"
    },
    "448": {
     "text": "**त्र्यधिका विंशतिरब्दास्तदेह[^47] मम जन्मनोऽतीताः ॥ १० ॥ **",
     "sha256": "8be41bd49f939a609c0571518a9e952771635ef058f26ff260a2a4046dad323f"
    },
    "658": {
     "text": "\"भापक्रमो ग्रहांशाः शशिविक्षेपोऽपमण्डलाज्झार्धम्।",
     "sha256": "7bd1c41cba28fdf555f845c40153674bb225d3f549ecff1e9540675df3a5f0f3"
    },
    "664": {
     "excerpts": [
      "परमापक्रमचापं चतुर्विंशतिभागात्मकं सर्वत्र समानमेव।"
     ],
     "length": 863,
     "sha256": "58196ef34d4bc41cc2a5a55f80086e15dcd3f7fd127ea9c3f93bc892b8ff2d4e"
    }
   }
  },
  "etext:jm/goladipika.md": {
   "sha256": "d1940bc103b1effcf23789516c895a9dbafad2507bdf2e8ada33c1fbc66aab8c",
   "copy": "whole lines up to 300 characters",
   "lines": {
    "245": {
     "text": "स्थलजलमध्या[^12] लङ्का भूकक्ष्याया भवेच्चतुर्भागे।  ",
     "sha256": "26c7bd1eda85167a15c2bbb2c549b390f128ad2e23a059b08c3410283cd2950b"
    },
    "246": {
     "text": "उज्जचिनी लङ्कायाः पञ्चदशांशे समोत्तरतः ॥ ३८ ॥",
     "sha256": "12f5462b3cde24e0ab7c86c6aaba0001240483b6c464e573a61ca4f4503cb82e"
    },
    "790": {
     "text": "त्रिज्यालम्बोनर्क्षे भुवृत्तं रन्ध्रगोश्विगुणतुलितम्।  ",
     "sha256": "b3d4c05d345b5479eac4a74e2e3ca3b3ed1b80222e68c7329c614c7e09a3f696"
    },
    "822": {
     "text": "  विद्वन् ! वदस्वरकृताङ्गमिता पलज्या ॥ २०९॥  ",
     "sha256": "0d180fe592170116ee69879e61848e8e38eab2041764d6931b461e9abd61b78b"
    }
   }
  },
  "etext:jm/mulam.md": {
   "sha256": "ce1cfaa67e420b4eac9f188e22b4e3813a7f0fef67471eb7ff56219d2417057a",
   "copy": "the quoted excerpts only",
   "lines": {
    "8": {
     "excerpts": [
      "गणितानीतकालतः पश्चादेव हीदानीं सर्वाण्यपि ग्रहणानि दृश्यन्ते ।"
     ],
     "length": 292,
     "sha256": "4c913b44828d6a5aab79bd074465747bdcbc34f9a1a0523db5f35738a73dd333"
    },
    "10": {
     "excerpts": [
      "'ह्रासवृद्धयादितोऽर्कः' ( १६, ८१, ४७२ )",
      "मध्यतमस्कं ग्रहणमभूत् । तत्र स्पर्शे प्रत्यक्कपालगेऽर्के नृच्छाया पदद्वयम् ईषदधिकम् । मोक्षास्तमययोर्मध्ये चतस्र एव घटिकाः स्युः ।"
     ],
     "length": 328,
     "sha256": "742fc244d7c3f9dd945aced00695cc390f9522abc5a0aec7cbbfd5657488db2e"
    },
    "19": {
     "excerpts": [
      "अतो ग्रहणमेव न स्यात् ।"
     ],
     "length": 104,
     "sha256": "5a80b94091cee5cd7b9b3a34a03d1012856a9dd69186f8cbc85c4358310fbf91"
    },
    "21": {
     "excerpts": [
      "'संभुञ्जीताहिस्तपनम्' ( १६,८६,८४७ ) इत्यस्मिन्नहर्गणे स्पर्शोपलब्धा पदच्छाया एकादशसंख्या । मोक्षद्युगतं पुनः पञ्चदशघटिकाः अष्टांशतयसहिताः ।",
      "तस्मिन् दिनेऽपि गीतिकोक्तभगणादिसिद्धचन्द्रादिभिर्गण्यमाने ग्रहणं नैवात्र स्यात् ।"
     ],
     "length": 559,
     "sha256": "b2ee2c58041a125dbc50e89a96452f66f8969ba76dc3be0fb1e9430d79c24ec9"
    },
    "25": {
     "excerpts": [
      "क्षितिरवियोगाद् दिनकृत्, रवीन्दुयोगात् प्रसाधितश्चेन्दुः । शशिताराग्रहयोगात् तथैव ताराग्रहाः सर्वे ॥ ४८ ॥"
     ],
     "length": 109,
     "sha256": "9f0289499f29c435a31c07da7e55bc2d2c53ae20f2dce1758d0fd9aa5f933390"
    },
    "94": {
     "excerpts": [
      "तस्मात् शिष्य-प्रशिष्य-परम्परया सर्वैर् अपि परीक्षणं कार्यम् ।"
     ],
     "length": 76,
     "sha256": "fd29ab0fdf851d30c15eafdc7510ff7b2a33787df80111a5eb152653a30e3b64"
    },
    "178": {
     "excerpts": [
      "र ष हा गत्वांशकान् प्रथमपाताः ।"
     ],
     "length": 32,
     "sha256": "d41bb04c6a6e80398bd87ca8b704c46e81c2724762b7960831c71362cfcac6d7"
    },
    "183": {
     "excerpts": [
      "द्वा अखिसा हवा लय - खिच्य मन्दोच्चम् ॥"
     ],
     "length": 39,
     "sha256": "23da2a2d5ab5cae02dd7a3173632afdb81cb0e730ddda2bb7b33518582c1d885"
    },
    "207": {
     "excerpts": [
      "तस्मात् शिष्याणां ग्रह-गति-परीक्षा-सामर्थ्यापादनम् एव शास्त्र-प्रयोजनम्।"
     ],
     "length": 83,
     "sha256": "a938f36e73f39abd4948125cd196d5fb2a734e0da03cd529addf75f440fadf23"
    },
    "208": {
     "excerpts": [
      "ते पुनः दृक्संवादि करणं कृत्वा"
     ],
     "length": 32,
     "sha256": "c248aa877277470c092e0d8458e46ae33181b860b6a2f1f4d024ee49089da69f"
    },
    "209": {
     "excerpts": [
      "लोके सञ्चारयेयुः ।"
     ],
     "length": 20,
     "sha256": "344ad116548b62355dd752d883c5b76b2d9a09cd088ba5b45d6af8cd17ca8145"
    },
    "271": {
     "excerpts": [
      "\"चन्द्रे बाणकरा बीजाः, चन्द्रोच्चे मनुभूमयः ॥ २०b"
     ],
     "length": 50,
     "sha256": "a302554eedcfcda6a2716b35a7280e52c09d55d74e65ce7484a0cb979927fc83"
    },
    "275": {
     "excerpts": [
      "कुजे शून्यशरा ज्ञेयाः, खाग्निवेदा बुधस्य तु ।"
     ],
     "length": 46,
     "sha256": "d9b5fcc0384a2ef0220c0f1ba3193292b0c8b2c41040a563c0dbed9b02ae95ec"
    },
    "279": {
     "excerpts": [
      "गुरोः खपञ्च विज्ञेयाः, शुक्रे खाष्टनिशाकराः ॥ २१ ॥"
     ],
     "length": 51,
     "sha256": "a250c4abb7f22cc9b58214033029475542d363694ebb70663f3670900ec5efab"
    },
    "283": {
     "excerpts": [
      "शनैः शशिकराः प्रोक्ता, राहो षण्णवति स्मृताः ॥ २२ ॥"
     ],
     "length": 51,
     "sha256": "60ea4542321e3015d1eb290cd2e28f79db70c57538b72c92ae29bd9024ccb13e"
    },
    "287": {
     "excerpts": [
      "भवभानू निते शाके बीजघ्ने शबरोद्धृते ।"
     ],
     "length": 38,
     "sha256": "9807a9087b3e2efbcb20ab71fec3c9a75a0115bb0a7a4a0ee694d5d2ae0477aa"
    },
    "297": {
     "excerpts": [
      "राहुचन्द्रोच्चजीवानामृणं कार्यं भृगोरपि ॥ २० ॥"
     ],
     "length": 47,
     "sha256": "71b8e9b47f2e802287514bd5eb5b8911989c8135e8a4fe8de83e3fb3ad58a92e"
    },
    "305": {
     "excerpts": [
      "वाग्भावोनाच्छकान्वाद् धन-शत-लय-हात् मन्द-वैलक्ष्य-रागः ।"
     ],
     "length": 57,
     "sha256": "a3e2fa7500053c104d81747c1a720170adc562b81336b3873dcc53be71e33338"
    },
    "312": {
     "excerpts": [
      "शोभा-नीरूढ-संविद्-गणक-नर-हतात् मागराप्ताः कुजाद्याः"
     ],
     "length": 52,
     "sha256": "5fee6fc0e9387fc25779d129d4ad9776c7881f6877e6c61c493b92b555466a07"
    },
    "321": {
     "excerpts": [
      "चत्वारिंशल्लिप्ता देया मध्ये कुजस्य, रविसूनोः । अष्टादश ।"
     ],
     "length": 66,
     "sha256": "3af43c48b7ad752149eb49115ee7f744ceab49978819f7b4a829720c4c94aaf3"
    },
    "327": {
     "excerpts": [
      "अगवसुशर-शककालान्तरः स्मृतः करणवत्सरसमूहः ।"
     ],
     "length": 43,
     "sha256": "0949aaa45d8304436db5f3c03d32386d2f06a7d080d9aa9bee4016344a295087"
    },
    "329": {
     "excerpts": [
      "तस्माद् धृत्यंशकला [स] षट्कलाः शीतगोः शोध्याः ॥"
     ],
     "length": 48,
     "sha256": "9ccef1a6eae5a39dfb0605eae1359dc983e63c5895e58e5e9c5db87b330d0325"
    },
    "344": {
     "excerpts": [
      "शके नखाब्धि-रहिते शशिनो ऽक्षवस्त्रः"
     ],
     "length": 36,
     "sha256": "2c3a67165a3b9fd028a29d0bf34ca99517d13ea7e1b5a514038d490778402671"
    },
    "347": {
     "excerpts": [
      "तत्तुङ्गतः कृतशिवैः, तमसः षडः ।"
     ],
     "length": 32,
     "sha256": "37f719ffe40f4c3713fdc34041b1518f26af49c7d359a089cd8de6cae08263a9"
    },
    "349": {
     "excerpts": [
      "शैलाब्धिभिः सुरगुरोः, गुणितो सितोच्चात्"
     ],
     "length": 40,
     "sha256": "e1da5b4b7a8f76af6d102d0ce99a74b9cc3f6e664f062efaea388f60ce95db06"
    },
    "352": {
     "excerpts": [
      "शोध्यं त्रिपञ्चकु-हतेऽष्टशराक्षि-भक्ते ।"
     ],
     "length": 41,
     "sha256": "775322bc9e219a0d316b7a7d4532f383dd410e60364b48ccc4fe2e8c42b68d0a"
    },
    "354": {
     "excerpts": [
      "स्तम्बेरमाम्बुधिहते क्षितिनन्दनस्य"
     ],
     "length": 35,
     "sha256": "58d35ba51ce418e1936d0b740f4fa7fe46ed3ecb83a6ff1ca687b4004d4feddf"
    },
    "356": {
     "excerpts": [
      "सूर्यात्मजस्य गुणितेऽम्बरलोचनैश्च ।"
     ],
     "length": 36,
     "sha256": "d10b9d77f9c917a28637d6b7a1b5e9c05904f883cd7e51f6ad170b555a486987"
    },
    "358": {
     "excerpts": [
      "व्योमाग्निसागरगुणे विदधीत लब्धं"
     ],
     "length": 32,
     "sha256": "54adf589954493b15c7b0cae2f1d7903e8c78f8fc3666c701f5778b5506d99d7"
    },
    "404": {
     "excerpts": [
      "'भवभानु' (४४४) - 'शबर' (२३५) - योगमिते 'धीस्थिते' (६७९) शाके हि प्रत्यक्षसिद्धस्य गणितानीतस्य चान्तरं 'बाणकर'"
     ],
     "length": 585,
     "sha256": "a1821cce2fbdbcc065147d2e334be4eb5493877f48af215540d5d4aa3e4b1b76"
    },
    "429": {
     "excerpts": [
      "पादोनाष्टाविंशतिः पादोनच्छिद्रचतुर्ज्या ।"
     ],
     "length": 42,
     "sha256": "a7ef774d5e98f57715f0e0e9c7e7bda05a68e5eb321ab98a81bb91643a814d0b"
    },
    "434": {
     "excerpts": [
      "'मुन्यंशः' सप्तमांशो वा पञ्चमांशो वेति संशय्य बहूपरागदर्शनेन पञ्चांशोनत्वं निर्णीय"
     ],
     "length": 579,
     "sha256": "8092413592124a670af64c365d7660eb9c98a7dde7eaaacd5c0e4b8979ac1cc5"
    },
    "447": {
